{
  "title": "Messaging — RabbitMQ & 이벤트 체인",
  "uid": "hellocs-messaging",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "graphTooltip": 1,
  "time": { "from": "now-5m", "to": "now" },
  "tags": ["hellocs", "messaging"],
  "templating": {
    "list": [
      {
        "name": "queue",
        "label": "큐",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(rabbitmq_detailed_queue_messages_ready, queue)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "RabbitMQ 큐 개요",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "큐별 대기 메시지 (ready)",
      "gridPos": { "x": 0, "y": 1, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"$queue\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}] }, "color": { "mode": "thresholds" } }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "큐별 미확인 메시지 (unacked)",
      "gridPos": { "x": 10, "y": 1, "w": 10, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_unacked{queue=~\"$queue\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 5 } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "큐별 소비자 수",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_consumers{queue=~\"$queue\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}] }, "color": { "mode": "thresholds" } }
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "채점 이벤트 체인 (quiz → grading → RabbitMQ → ranking · streak)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Publish Rate (전체 채널)",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_detailed_channel_messages_published_total[1m]))",
          "legendFormat": "published/s",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 5 } } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Deliver Rate (큐별)",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(rabbitmq_detailed_queue_messages_delivered_total{queue=~\"$queue\"}[1m])",
          "legendFormat": "deliver / {{queue}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 5 } } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Ack Rate (큐별)",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(rabbitmq_detailed_queue_messages_acked_total{queue=~\"$queue\"}[1m])",
          "legendFormat": "ack / {{queue}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 5 } } }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "체인 소비 지연 (큐 depth 급증 = 소비자 병목)",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"ranking.grading.completed|streak.grading.completed|streak.interview.completed\"}",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}] }, "color": { "mode": "thresholds" } }
      }
    }
  ]
}
