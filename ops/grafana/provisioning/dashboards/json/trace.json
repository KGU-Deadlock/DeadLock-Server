{
  "title": "Trace — 분산 트레이싱",
  "uid": "hellocs-trace",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["hellocs", "trace"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(traces_spanmetrics_duration_milliseconds_count, service_name)",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "서비스 요청 흐름",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "초당 스팬 수",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_duration_milliseconds_count{service_name=~\"$service\"}[1m]))",
          "legendFormat": "spans/s",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}] }, "color": { "mode": "thresholds" } }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "에러 스팬 비율",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(traces_spanmetrics_duration_milliseconds_count{service_name=~\"$service\",status_code=\"STATUS_CODE_ERROR\"}[5m])) / sum(rate(traces_spanmetrics_duration_milliseconds_count{service_name=~\"$service\"}[5m]))",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.05}] }, "color": { "mode": "thresholds" } }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 스팬 레이턴시",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p95 ms",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}] }, "color": { "mode": "thresholds" } }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "서비스별 레이턴시",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "서비스별 p50/p95/p99 레이턴시 (ms)",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p50 / {{service_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p95 / {{service_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(traces_spanmetrics_duration_milliseconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p99 / {{service_name}}",
          "refId": "C"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 1, "fillOpacity": 3 } } }
    },
    {
      "id": 15,
      "type": "row",
      "title": "서비스 그래프 (호출 엣지)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "엣지 호출률 (calls/s)",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(traces_service_graph_request_total{client=~\"$service\"}[1m])",
          "legendFormat": "{{client}} → {{server}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 5 } } }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "엣지 에러율",
      "gridPos": { "x": 8, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(traces_service_graph_request_failed_total{client=~\"$service\"}[1m]) / rate(traces_service_graph_request_total{client=~\"$service\"}[1m])",
          "legendFormat": "{{client}} → {{server}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "lineWidth": 1, "fillOpacity": 5 }, "color": { "fixedColor": "red", "mode": "fixed" } } }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "엣지 p95 레이턴시",
      "gridPos": { "x": 16, "y": 15, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_client_seconds_bucket{client=~\"$service\"}[5m])))",
          "legendFormat": "{{client}} → {{server}}",
          "refId": "A"
        }
      ],
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 3 } } }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Trace 검색",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }
    },
    {
      "id": 21,
      "type": "traces",
      "title": "Trace 탐색기",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 15 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceqlSearch",
          "filters": [
            {
              "id": "service-name",
              "operator": "=~",
              "scope": "resource",
              "tag": "service.name",
              "value": ["$service"],
              "valueType": "string"
            }
          ],
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ]
}
