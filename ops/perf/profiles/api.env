# ============================================================
# Perf Baseline — API 믹스 & SLO
# ------------------------------------------------------------
# - 핵심 학습 루프만(interview/stt 제외).
# - RATIO_* = 전체 요청 대비 비율(%) 고정. 합 = 100.
# - P95_*   = 목표 p95(ms).
# - baseline = 모든 P95 만족 + 에러율<1% 인 최대 지속 RPS.
#
# [그룹 비율]  (streak+ranking) : (quiz+grading) : user : topic = 4.5 : 5 : 0.5 : 0.5
#   · streak/ranking: 메인화면 상시 노출 + 퀴즈 풀면 갱신 → 높음(프론트 캐시 감안 4.5)
#   · quiz/grading  : 학습 핵심 루프 → 최다 5
#   · user/topic    : 보조 조회 → 각 0.5
# [모듈 점유]  grading 42 / streak 18 / ranking 16 / quiz 14 / user 5 / topic 5
# [제외]  계정 ops(signup/patch/delete): 정상 스테디 부하 아님
# ============================================================

# ===== streak-service (모듈 18%) ================  요약:월별:상세 = 4:1:1
# GET /v1/streak — 스트릭 요약(메인화면)
RATIO_STREAK_SUMMARY=12
P95_STREAK_SUMMARY=300
# GET /v1/streak?year&month — 월별 스트릭
RATIO_STREAK_MONTHLY=3
P95_STREAK_MONTHLY=1000
# GET /v1/streak/detail — 스트릭 상세
RATIO_STREAK_DETAIL=3
P95_STREAK_DETAIL=1000

# ===== ranking-service (모듈 16%) ===============  요약:페이지 = 4:1
# GET /v1/ranking/summary — 랭킹 요약(메인화면)
RATIO_RANKING_SUMMARY=12
P95_RANKING_SUMMARY=300
# GET /v1/ranking — 랭킹 페이지
RATIO_RANKING_PAGE=4
P95_RANKING_PAGE=1000

# ===== quiz-service (모듈 16%) ==================  조회 단일
# POST /v1/quiz — 퀴즈 조회/생성(내부 fan-out: user×2/topic/grading)
RATIO_QUIZ_FETCH=16
P95_QUIZ_FETCH=3000

# ===== grading-service (모듈 40%) ===============  제출:결과:상세:목록 = 10:10:10:10
# POST /v1/quiz/grading — 채점 제출(AI정책/write/이벤트)
RATIO_GRADING_SUBMIT=10
P95_GRADING_SUBMIT=10000
# GET /v1/quiz/grading/{gradingLogId} — 채점 결과
RATIO_GRADING_RESULT=10
P95_GRADING_RESULT=500
# GET /v1/quiz/grading/{gradingLogId}/{quizId} — 채점 상세
RATIO_GRADING_DETAIL=10
P95_GRADING_DETAIL=500
# GET /v1/quiz/grading/list — 채점 히스토리 목록
RATIO_GRADING_LIST=10
P95_GRADING_LIST=

# ===== user-service (모듈 5%) ===================
# GET /v1/users/me — 내 프로필
RATIO_USER_ME=5
P95_USER_ME=300

# ===== topic-service (모듈 5%) ==================
# GET /v1/topics — 토픽 목록
RATIO_TOPICS=5
P95_TOPICS=200

# ── 검증(참고) ───────────────────────────────────────────────
# 합 = 100
# 모듈 점유: grading 40 / streak 18 / ranking 16 / quiz 16 / user 5 / topic 5
# 읽기:쓰기 = 76:24 (쓰기 = 퀴즈조회 POST 14 + 채점제출 10)
# 내부호출(비율 밖, 상위 API에 종속):
#   quiz→user(level,interest) / quiz→topic(names,ids) / quiz→grading(solved-ids)
#   ranking→user(profile-summaries) / grading→(ranking,streak) 채점이벤트
