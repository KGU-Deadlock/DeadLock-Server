# ============================================================
# Perf Baseline — 데이터셋 (세그먼트 분포 모델)
# ------------------------------------------------------------
# - "모두 N일 균등" 폐기 → N명을 활동 빈도 세그먼트로 분포.
# - N 만 키우면 분포 비율 유지한 채 전체가 비례 스케일.
# - bake/seeder 가 이 값으로 생성하도록 수정.
#
# [grading log 생성 규칙]
#  · 모든 유저의 가입일을 0~180일(계정나이)에 균등 분산.
#  · 활동일 = 계정나이 ÷ 7 × DAYS_PER_WEEK (주당 활동일).
#  · 풀이 수 = 활동일 × DATASET_QUIZ_PER_DAY (하루 30문항).
#    예) regular(주4) 가입 140일 → 140/7×4 = 80일 → 80×30 = 2400풀이.
#    예) power(매일)  가입 180일 → 180/7×7 = 180일 → 180×30 = 5400풀이.
#  · 가입일 0 근처 유저는 활동일≈0 → 자연스러운 "신규" 효과(별도 newbie 세그먼트 불필요).
#  · grading_logs(세션) = 활동일당 1건(그날 30문항을 담음).
# ============================================================

# ── 기본 파라미터 ────────────────────────────────────────────
DATASET_USERS=10000          # 등록 유저 수 (단일 스케일 노브)
DATASET_QUIZ_PER_DAY=30      # 활동일당 풀이 문항 수
DATASET_SIGNUP_WINDOW_DAYS=180  # 가입일 0~180일 균등 분산(계정나이)
DATASET_QUIZ_BANK=10000      # 퀴즈 뱅크 총 문항(power 누적 5400 < 10000 → solved제외 안마름)
DATASET_TOPICS=6             # 토픽 수(DevTopicSeedController 하드코딩 6개와 일치)

# ── 활동 세그먼트 (비율 2:5:3, share 합 = 1.0) ───────────────
# share=비율, DAYS_PER_WEEK=주당 활동일. 활동일=계정나이÷7×DAYS_PER_WEEK
# power(매일) — 주 7일
SEG_POWER_SHARE=0.2
SEG_POWER_DAYS_PER_WEEK=7
# regular(주4) — 주 4일
SEG_REGULAR_SHARE=0.5
SEG_REGULAR_DAYS_PER_WEEK=4
# casual(주2) — 주 2일
SEG_CASUAL_SHARE=0.3
SEG_CASUAL_DAYS_PER_WEEK=2

# ── k6 토큰 풀(핫키 분포) ────────────────────────────────────
# 트래픽은 활동 유저가 생성 → 데이터 있는 유저에 조회 집중(현실적 캐시/인덱스)
# 헤비 유저가 더 자주 들어옴 → 인구 비율(2:5:3)보다 power 가중 ↑
TOKEN_POOL_SIZE=1000
TOKEN_POOL_W_POWER=0.30
TOKEN_POOL_W_REGULAR=0.50
TOKEN_POOL_W_CASUAL=0.20

# ── 파생 규모(자동 산출, 참고 / N=10000, 계정나이 평균 90일 기준) ──
# 세그먼트별 (유저수 × 평균활동일 × 30):
#   power   2000 × 90.0 ×30 = 5,400,000 풀이  (활동일 180,000)
#   regular 5000 × 51.4 ×30 = 7,714,000 풀이  (활동일 257,000)
#   casual  3000 × 25.7 ×30 = 2,314,000 풀이  (활동일  77,000)
# ------------------------------------------------------------
# 총 풀이(grading detail)  ≈ 15,400,000   (Mongo, 세션에 임베드)
# grading_logs(세션)       ≈    514,000 doc (활동일당 1건)
# daily_streak_records     ≈    514,000 doc (활동일당 1건)
# user_streaks             =     10,000 doc (전원 활동)
# ranking ZSET member      =     10,000     (전원 점수 보유)
# solved_quiz_ids/유저     = 활동일×30 (power 최대 5,400 < bank 10,000)
# postgres user            =     10,000 row
# postgres topic           =          8 row
# postgres quiz            =     10,000 row (유저 독립 카탈로그)
#
# [규모 주의] 총 풀이 ≈ 1,540만. regular(주4, 인구 50%)가 최대 기여.
