# ============================================================
# Perf Baseline — 모듈별 격리 하드웨어 할당 (SUT 6 vCPU / 12 GB)
# ------------------------------------------------------------
# 【사용 방식】
#   -Module all  : 이 파일의 모든 값을 그대로 적용 (통합 부하테스트).
#   -Module <단일>: run.ps1 이 런타임에 k6/.hardware-effective.env 를 생성.
#                  선택 모듈 + 전용 DB 만 아래 한도를 적용하고,
#                  나머지 *_CPU_LIMIT / *_MEMORY_LIMIT 은 모두 0(무제한)으로 재정의.
#
# 【모듈 → 전용 DB 매핑 (격리 대상)】
#   quiz    → postgres-quiz   (POSTGRES_QUIZ_CPU_LIMIT / POSTGRES_QUIZ_MEMORY_LIMIT)
#   user    → postgres-user   (POSTGRES_USER_CPU_LIMIT / POSTGRES_USER_MEMORY_LIMIT)
#   topic   → postgres-topic  (POSTGRES_TOPIC_CPU_LIMIT / POSTGRES_TOPIC_MEMORY_LIMIT)
#   grading → (공유: Mongo/Redis/RabbitMQ) — 모듈 컨테이너만 한도 적용, DB는 무제한
#   streak  → (공유: Mongo/RabbitMQ)       — 모듈 컨테이너만 한도 적용, DB는 무제한
#   ranking → (공유: Redis/RabbitMQ)       — 모듈 컨테이너만 한도 적용, DB는 무제한
#
# 【예산】 SUT(모듈+DB+MQ)만. 모니터링/k6/dev-service 는 예산 밖.
#   모듈 7개 × (0.5 vCPU / 1024m) = 3.50 vCPU / 7168m
#   DB   5개 × (0.45 vCPU / 768m) = 2.25 vCPU / 3840m
#   MQ   1개 × (0.25 vCPU / 512m) = 0.25 vCPU /  512m
#   ----------------------------------------------------------
#   합계                          = 6.00 vCPU / 11520m(≈11.25GB)
# ============================================================

# ── 모듈 (각 0.5 vCPU / 1024m) ───────────────────────────────
GATEWAY_CPU_LIMIT=0.5
GATEWAY_MEMORY_LIMIT=1024m
GRADING_CPU_LIMIT=0.5
GRADING_MEMORY_LIMIT=1024m
QUIZ_CPU_LIMIT=0.5
QUIZ_MEMORY_LIMIT=1024m
USER_CPU_LIMIT=0.5
USER_MEMORY_LIMIT=1024m
STREAK_CPU_LIMIT=0.5
STREAK_MEMORY_LIMIT=1024m
RANKING_CPU_LIMIT=0.5
RANKING_MEMORY_LIMIT=1024m
TOPIC_CPU_LIMIT=0.5
TOPIC_MEMORY_LIMIT=1024m

# ── DB (각 0.45 vCPU / 768m) ─────────────────────────────────
MONGO_CPU_LIMIT=0.45
MONGO_MEMORY_LIMIT=768m
POSTGRES_USER_CPU_LIMIT=0.45
POSTGRES_USER_MEMORY_LIMIT=768m
POSTGRES_TOPIC_CPU_LIMIT=0.45
POSTGRES_TOPIC_MEMORY_LIMIT=768m
POSTGRES_QUIZ_CPU_LIMIT=0.45
POSTGRES_QUIZ_MEMORY_LIMIT=768m
REDIS_CPU_LIMIT=0.45
REDIS_MEMORY_LIMIT=768m

# ── MQ (0.25 vCPU / 512m) ────────────────────────────────────
RABBITMQ_CPU_LIMIT=0.25
RABBITMQ_MEMORY_LIMIT=512m

# ── 참고 ─────────────────────────────────────────────────────
# - docker-compose.perf.yml 의 각 서비스는 ${X_CPU_LIMIT:-0} / ${X_MEMORY_LIMIT:-0} 형태로
#   값이 0 이면 무제한(Docker Compose 기본값)이 되도록 설정되어 있음.
# - dev/stt/interview/postgres-interview 는 baseline 미가동 또는 예산 외 → 이 파일에 미정의.
# - JVM 힙은 -XX:MaxRAMPercentage=70 권장 (컨테이너 메모리 한도 70% 사용).
